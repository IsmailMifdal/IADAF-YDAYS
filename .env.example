# =============================================
# IA-DAF — Docker Compose Environment Variables
#
# Copy to `.env` and fill in the real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# =============================================

# --- PostgreSQL ---
POSTGRES_DB=iadaf_db
POSTGRES_USER=iadaf_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
# One account per service, each limited to its own schema
# (docker/postgres/provision.sql). Empty = development defaults; required in
# production (deploy/generate-secrets.sh draws them). The superuser above is
# kept for backups and administration only.
FRONTEND_DB_PASSWORD=
PROFILES_DB_PASSWORD=
DEMARCHES_DB_PASSWORD=
DOCUMENTS_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=
AI_DB_PASSWORD=

# --- OpenAI (ai-service) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Empty = OpenAI (US). To keep conversations in the EU, point to an
# OpenAI-compatible EU provider, e.g. Mistral:
#   OPENAI_BASE_URL=https://api.mistral.ai/v1
#   OPENAI_MODEL=mistral-small-latest
#   OPENAI_API_KEY=<clé Mistral>
OPENAI_BASE_URL=
# Low on purpose: administrative answers must be factual.
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000
# A 1000-token answer can take a minute to generate; the gateway gives AI
# routes 90 s (api-gateway GatewayConfig). Streamed chat is not affected.
OPENAI_TIMEOUT_SECONDS=60

# --- Auth.js (NextAuth, frontend) ---
# Generate one per environment:  openssl rand -base64 32
AUTH_SECRET=generate-a-32-byte-base64-secret
# Public base URL of the frontend.
AUTH_URL=http://localhost:3000
# Required when Next.js runs behind Docker / a reverse proxy.
AUTH_TRUST_HOST=true

# --- Frontend ↔ backend ---
# Key of the short-lived JWTs the frontend signs for every backend call. The
# gateway, the AI service and the Java services reject any call without one,
# and refuse to start if it is missing or shorter than 32 bytes.
#   openssl rand -hex 32
INTERNAL_JWT_SECRET=generate-a-32-byte-hex-secret
# Conversations inactive for longer than this are purged (RGPD).
CONVERSATION_RETENTION_DAYS=30

# --- Documents (document-service) ---
# AES-256 key that encrypts every filed document before it reaches the
# database: 32 random bytes, base64.  openssl rand -base64 32
# Keep it safe and back it up apart from the database: losing it makes every
# stored document unreadable; leaking it, together with a backup, exposes them.
DOCUMENT_ENCRYPTION_KEY=generate-32-random-bytes-in-base64
# Documents older than this are erased automatically (RGPD).
DOCUMENT_RETENTION_DAYS=180

# --- Automated document pre-check (ai-service, Phase 4) ---
# Off by default: automated processing of identity documents, to switch on
# only once the AIPD is done (docs/rgpd/aipd-preparation.md). The dev
# override switches it on.
DOCUMENT_ANALYSIS_ENABLED=false
# OCR of photos and scans — sends the image of identity documents to a third
# party: signed DPA and EU hosting required. Empty = off (PDFs with a text
# layer are still read, photos are still checked for quality).
OCR_PROVIDER=
OCR_API_KEY=

# --- Google OAuth (optional) ---
# Leave empty to hide the "Continue with Google" button.
# Callback URL to declare in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (payments, test mode) ---
# Keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
# Signing secret of the webhook endpoint (stripe listen / dashboard).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- E-mail (password reset) ---
# Any SMTP provider: Brevo, Mailgun, Scaleway TEM, the host's relay…
#   SMTP_URL=smtps://user:password@smtp.example.com:465
# Empty in development: the message is printed in the frontend logs instead.
SMTP_URL=
MAIL_FROM=IA-DAF <no-reply@example.com>

# --- Spring Boot ---
SPRING_JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO
