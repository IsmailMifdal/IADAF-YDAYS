# =============================================
# IA-DAF — Docker Compose Environment Variables
#
# Copy to `.env` and fill in the real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# =============================================

# --- PostgreSQL ---
POSTGRES_DB=iadaf_db
POSTGRES_USER=iadaf_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# --- OpenAI (ai-service) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT=30000

# --- Auth.js (NextAuth, frontend) ---
# Generate one per environment:  openssl rand -base64 32
AUTH_SECRET=generate-a-32-byte-base64-secret
# Public base URL of the frontend.
AUTH_URL=http://localhost:3000
# Required when Next.js runs behind Docker / a reverse proxy.
AUTH_TRUST_HOST=true

# --- Frontend ↔ AI service ---
# Shared secret: lets the AI service trust the user id the frontend attaches,
# and restricts data erasure to the frontend.  openssl rand -hex 32
INTERNAL_API_TOKEN=generate-a-32-byte-hex-secret
# Conversations inactive for longer than this are purged (RGPD).
CONVERSATION_RETENTION_DAYS=30

# --- Google OAuth (optional) ---
# Leave empty to hide the "Continue with Google" button.
# Callback URL to declare in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (payments, test mode) ---
# Keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
# Signing secret of the webhook endpoint (stripe listen / dashboard).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- Spring Boot ---
SPRING_JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO
