# Copy values into IADAF-YDAYS/.env (or ai-service/.env) when Strata is the LLM backend.
# Portable: no machine-specific username. Override STRATA_HOME if needed.

USE_OPENAI=true
# ai-service in Docker → host Strata (default local server port):
OPENAI_BASE_URL=http://host.docker.internal:8080/v1
# ai-service on the host:
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=replace-with-strata-api-key
# Exact id from: curl http://127.0.0.1:8080/v1/models
OPENAI_MODEL=qwen3.8-flash-next-iq2_xs
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT_SECONDS=60

STRATA_API_KEY=replace-with-strata-api-key
STRATA_PORT=8080
# Optional — only if Strata is not on PATH and not under %USERPROFILE%\Strata / $HOME/Strata:
# STRATA_HOME=
# STRATA_CONFIG=
