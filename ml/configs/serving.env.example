# Copier vers ai-service/.env (ou surcharger) pour la stack locale v3.1.
# start-local-v3_1.ps1 synchronise DATABASE_URL depuis ml/.tools/pg_uri.txt.

USE_OPENAI=true

# --- Local GGUF (llama.cpp) ---
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=iadaf-dev-local-key
OPENAI_MODEL=iadaf-qwen3-8b-v3_1-Q4_K_M.gguf

# --- Prod multi-user (TRT IADAF NVFP4) ---
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_MODEL=iadaf_qwen3_8b_nvfp4

OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT_SECONDS=60

INTERNAL_JWT_SECRET=iadaf-local-eval-jwt-secret-32b-min!!
# Rempli automatiquement par start-local-v3_1.ps1 si Postgres embarqué :
# DATABASE_URL=postgresql+asyncpg://iadaf_user:iadaf_password@127.0.0.1:PORT/iadaf_db
