# AI Service environment variables — copy to .env and adjust

# Eureka Discovery Service
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI fallback (set USE_OPENAI=true and provide key to activate)
OPENAI_API_KEY=
USE_OPENAI=false

# ChromaDB vector store (persistent)
# Use an absolute path in Docker: /data/vectorstore
CHROMA_PERSIST_DIR=./app/data/vectorstore

# SQLite database
DATABASE_URL=sqlite+aiosqlite:///./app/data/iadaf.db

# Service host/port
APP_HOST=0.0.0.0
APP_PORT=8086
