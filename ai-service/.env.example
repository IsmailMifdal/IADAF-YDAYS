# AI Service environment variables — copy to .env and adjust

# Eureka Discovery Service
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI-compatible LLM (set USE_OPENAI=true and provide key to activate).
# Local Strata on this PC (ml/serving/strata-iadaf.ps1):
#   USE_OPENAI=true
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=<same as STRATA_API_KEY>
#   OPENAI_MODEL=<id from GET /v1/models>
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI=false

# ChromaDB vector store (persistent)
# Use an absolute path in Docker: /data/vectorstore
CHROMA_PERSIST_DIR=./app/data/vectorstore

# SQLite database
# PostgreSQL (schema "ai", created by the migrations at startup).
# Locally: docker compose up -d postgres
DATABASE_URL=postgresql+asyncpg://iadaf_user:iadaf_password@localhost:5432/iadaf_db

# Conversations inactive for longer than this are purged (RGPD)
CONVERSATION_RETENTION_DAYS=30

# Verifies the JWTs signed by the frontend — same value as its
# INTERNAL_JWT_SECRET (32 bytes minimum; the service won't start without it)
INTERNAL_JWT_SECRET=

# Service host/port
APP_HOST=0.0.0.0
APP_PORT=8086
