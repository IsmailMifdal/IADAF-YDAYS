# Frontend environment variables.
# For local development:  cp .env.example .env.local
# Under Docker these are injected by docker-compose from the root .env.

# --- Database (Auth.js users + pack entitlements) ---
DATABASE_URL=postgresql://iadaf_user:iadaf_password@localhost:5432/iadaf_db

# --- Auth.js ---
# Generate one per environment:  openssl rand -base64 32
AUTH_SECRET=generate-a-32-byte-base64-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Google OAuth (optional) ---
# Leave empty to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Backend ---
API_GATEWAY_URL=http://localhost:8080
# Same value as the AI service's INTERNAL_API_TOKEN.  openssl rand -hex 32
INTERNAL_API_TOKEN=generate-a-32-byte-hex-secret

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
