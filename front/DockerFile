FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV NEXT_PUBLIC_API_GATEWAY_URL=http://api-gateway:8080
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

# Le serveur standalone se lie à $HOSTNAME, qui vaut l'ID du conteneur sous
# Docker : il n'écouterait alors ni sur la loopback ni sur toutes les
# interfaces, ce qui casse le healthcheck.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000
CMD ["node", "server.js"]
